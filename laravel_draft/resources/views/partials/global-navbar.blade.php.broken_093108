<script>
(function(){
  var box = document.getElementById('nsGlobalSearch');
  var out = document.getElementById('nsSearchResults');
  if(!box || !out) return;

  var PAGES = [
    ['Bill Generation','control-room'],
    ['Free Allowances','allowances'],
    ['Meter Readings','meters-readings'],
    ['Rates & Charges','rates'],
    ['Attendance Days','active-days-monthly'],
    ['Employees','people-residency'],
    ['Families','family-list'],
    ['Room Occupancy','occupancy'],
    ['Unit Directory','unit-directory'],
    ['Employee Statement','statement-v2'],
    ['Monthly Summary','reports/monthly-summary'],
    ['Recovery Report','reports/recovery'],
    ['Reconciliation','reports/reconciliation'],
    ['Downloads','export'],
    ['Transport','transport'],
    ['Users','ui/admin/users'],
    ['Dashboard','dashboard']
  ];
  var BASE = '{{ url('/') }}';

  function render(html){ out.innerHTML = html; out.style.display = html ? 'block' : 'none'; }
  function esc(s){ return String(s).replace(/[<>&]/g, function(c){return {'<':'&lt;','>':'&gt;','&':'&amp;'}[c];}); }

  var timer = null;
  box.addEventListener('input', function(){
    var q = box.value.trim();
    clearTimeout(timer);
    if(q.length < 2){ render(''); return; }

    timer = setTimeout(function(){
      var pages = PAGES.filter(function(p){ return p[0].toLowerCase().indexOf(q.toLowerCase()) > -1; });
      var html = '';
      if(pages.length){
        html += '<div style="padding:8px 12px;font-size:11px;font-weight:700;color:#737685;text-transform:uppercase">Pages</div>';
        pages.forEach(function(p){
          html += '<a href="'+BASE+'/'+p[1]+'" style="display:block;padding:9px 14px;font-size:14px;color:#191c1e;text-decoration:none;border-top:1px solid #f1f2f4">'+esc(p[0])+'</a>';
        });
      }
      render(html + '<div style="padding:9px 14px;font-size:13px;color:#737685;border-top:1px solid #f1f2f4">Searching employees…</div>');

      fetch(BASE+'/employees/search?q='+encodeURIComponent(q), {headers:{'Accept':'application/json'}})
        .then(function(r){ return r.json(); })
        .then(function(d){
          var rows = d.data || d.rows || d.employees || [];
          var eh = '';
          if(rows.length){
            eh += '<div style="padding:8px 12px;font-size:11px;font-weight:700;color:#737685;text-transform:uppercase;border-top:1px solid #e2e8f0">Employees</div>';
            rows.slice(0,8).forEach(function(r){
              var cid = r.company_id || r.CompanyID || '';
              var nm  = r.name || r.Name || '';
              eh += '<a href="'+BASE+'/employee-profile/'+encodeURIComponent(cid)+'" style="display:block;padding:9px 14px;font-size:14px;color:#191c1e;text-decoration:none;border-top:1px solid #f1f2f4"><strong>'+esc(nm)+'</strong> <span style="color:#737685;font-size:12px">'+esc(cid)+'</span></a>';
            });
          } else {
            eh = '<div style="padding:9px 14px;font-size:13px;color:#737685;border-top:1px solid #f1f2f4">No employees found</div>';
          }
          render(html + eh);
        })
        .catch(function(){ render(html); });
    }, 250);
  });

  document.addEventListener('click', function(e){
    if(!out.contains(e.target) && e.target !== box) render('');
  });
})();
</script>
